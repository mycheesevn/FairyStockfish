@@ -80,9 +92,22 @@
 
 void Thread::start_searching() {
 
+#ifdef FAIRY_WASM_SYNC
+  // Synchronous search on the calling thread (no worker thread exists in a
+  // no-pthread WASM build). Mirrors idle_loop()'s bookkeeping: it would wake,
+  // run search(), then clear 'searching' and notify waiters when parking.
+  if (exit)
+      return;
+
+  searching = true;
+  search();
+  searching = false;
+  cv.notify_one(); // Wake up anyone waiting for search finished
+#else
   std::lock_guard<std::mutex> lk(mutex);
   searching = true;
   cv.notify_one(); // Wake up the thread in idle_loop()
+#endif
 }
 
 
